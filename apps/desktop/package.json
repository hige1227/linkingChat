{
  "name": "@linkingchat/desktop",
  "version": "0.0.1",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "dist": "electron-builder --win",
    "dist:dir": "electron-builder --win --dir",
    "prepare-sidecar": "bash scripts/prepare-sidecar.sh win-x64"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^electron$": "<rootDir>/../__mocks__/electron.ts",
      "^electron-store$": "<rootDir>/../__mocks__/electron-store.ts"
    }
  },
  "dependencies": {
    "@linkingchat/ws-protocol": "workspace:*",
    "electron-store": "^10.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.13.0",
    "socket.io-client": "^4.8.0",
    "ws": "^8.20.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.0.0",
    "electron": "^35.0.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^3.0.0",
    "i18next": "^25.8.14",
    "jest": "^29.7.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^16.5.6",
    "ts-jest": "^29.3.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.0"
  }
}
