# LinkingChat Production Environment Variables
# Copy to .env.production and fill in real values
# NEVER commit .env.production to git!

# Database
DB_PASSWORD=<strong-random-password>

# JWT RS256 Keys (base64 encoded)
JWT_PRIVATE_KEY=<base64-encoded-rs256-private-key>
JWT_PUBLIC_KEY=<base64-encoded-rs256-public-key>

# LLM API Keys (optional)
DEEPSEEK_API_KEY=
KIMI_API_KEY=

# S3-compatible Storage (Tencent Cloud COS or MinIO)
S3_ENDPOINT=<cos-endpoint-or-minio-host>
S3_PORT=443
S3_USE_SSL=true
S3_ACCESS_KEY=<access-key>
S3_SECRET_KEY=<secret-key>
S3_PUBLIC_URL=<public-url-for-files>
